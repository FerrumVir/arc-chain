{
  "name": "@arc-chain/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the ARC Chain RPC API - the agent-native L1 blockchain",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "clean": "node ./scripts/clean.mjs",
    "prepack": "npm run clean && npm run build",
    "test:package": "node ./test-package.mjs",
    "test": "npm run typecheck && npm run test:package"
  },
  "keywords": [
    "arc-chain",
    "blockchain",
    "l1",
    "agents",
    "rpc",
    "sdk",
    "typescript"
  ],
  "license": "BUSL-1.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/FerrumVir/arc-chain.git",
    "directory": "sdk/typescript"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
