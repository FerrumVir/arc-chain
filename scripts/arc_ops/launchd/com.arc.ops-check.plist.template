<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.arc.ops-check</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>cd @REPO@/scripts &amp;&amp; /usr/bin/python3 -m arc_ops.check --rpc @RPC_LIST@ --report @REPORT_DIR@/ops-$(date -u +%Y%m%dT%H%M%SZ).json</string>
  </array>
  <key>StartInterval</key>
  <integer>900</integer>
  <key>StandardOutPath</key>
  <string>@REPORT_DIR@/ops-check.log</string>
  <key>StandardErrorPath</key>
  <string>@REPORT_DIR@/ops-check.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
