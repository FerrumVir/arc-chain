{"id": "weather-city", "tools": ["get_weather", "get_time", "convert_currency"], "user": "What's the weather like in Lisbon right now? Use Celsius.", "call": {"name": "get_weather", "arguments": {"city": "Lisbon", "unit": "celsius"}}}
{"id": "weather-fahrenheit", "tools": ["get_weather", "get_time"], "user": "Tell me the current weather in Chicago in Fahrenheit.", "call": {"name": "get_weather", "arguments": {"city": "Chicago", "unit": "fahrenheit"}}}
{"id": "time-zone", "tools": ["get_weather", "get_time", "convert_currency"], "user": "What time is it in Tokyo?", "call": {"name": "get_time", "arguments": {"city": "Tokyo"}}}
{"id": "currency-eur-usd", "tools": ["get_weather", "convert_currency"], "user": "Convert 250 euros to US dollars.", "call": {"name": "convert_currency", "arguments": {"amount": 250, "from": "EUR", "to": "USD"}}}
{"id": "currency-jpy-gbp", "tools": ["convert_currency", "get_time"], "user": "How many British pounds is 12000 Japanese yen?", "call": {"name": "convert_currency", "arguments": {"amount": 12000, "from": "JPY", "to": "GBP"}}}
{"id": "email-send", "tools": ["send_email", "search_files", "create_event"], "user": "Email ana@example.com with the subject \"Invoice\" and the body \"The invoice is attached.\"", "call": {"name": "send_email", "arguments": {"to": "ana@example.com", "subject": "Invoice", "body": "The invoice is attached."}}}
{"id": "calendar-event", "tools": ["send_email", "create_event"], "user": "Put a meeting called \"Design review\" on my calendar for 2026-11-03 at 14:00, lasting 45 minutes.", "call": {"name": "create_event", "arguments": {"title": "Design review", "date": "2026-11-03", "time": "14:00", "duration_minutes": 45}}}
{"id": "files-search", "tools": ["search_files", "read_file", "send_email"], "user": "Find the files whose names contain \"quarterly report\".", "call": {"name": "search_files", "arguments": {"query": "quarterly report"}}}
{"id": "files-read", "tools": ["search_files", "read_file"], "user": "Open the file at /docs/plan.md and show me its contents.", "call": {"name": "read_file", "arguments": {"path": "/docs/plan.md"}}}
{"id": "math-sqrt", "tools": ["calculate", "get_weather"], "user": "Use the calculator to compute the square root of 1764.", "call": {"name": "calculate", "arguments": {"expression": "sqrt(1764)"}}}
{"id": "math-product", "tools": ["calculate", "convert_currency"], "user": "Calculate 37 * 49 with the calculator.", "call": {"name": "calculate", "arguments": {"expression": "37 * 49"}}}
{"id": "shell-tests", "tools": ["run_shell", "read_file", "search_files"], "user": "Run the command `cargo test -p arc-inference` in the repository.", "call": {"name": "run_shell", "arguments": {"command": "cargo test -p arc-inference"}}}
{"id": "git-branch", "tools": ["git_create_branch", "run_shell"], "user": "Create a git branch named feature/quality-harness starting from main.", "call": {"name": "git_create_branch", "arguments": {"name": "feature/quality-harness", "base": "main"}}}
{"id": "issue-create", "tools": ["create_issue", "send_email", "search_files"], "user": "Open a bug titled \"Login page times out\" with priority high.", "call": {"name": "create_issue", "arguments": {"title": "Login page times out", "priority": "high"}}}
{"id": "translate", "tools": ["translate_text", "send_email"], "user": "Translate \"Good morning, everyone\" into German.", "call": {"name": "translate_text", "arguments": {"text": "Good morning, everyone", "target_language": "German"}}}
{"id": "stock-quote", "tools": ["get_stock_price", "convert_currency", "get_time"], "user": "What's the latest stock price for the ticker NVDA?", "call": {"name": "get_stock_price", "arguments": {"ticker": "NVDA"}}}
