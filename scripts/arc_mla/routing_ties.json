{
  "about": "Deterministic MoE routing vectors with ties (spec 5.4-5.5). Read by the Rust unit tests (crates/arc-inference/src/modern/mla/ops.rs) and the Python reference tests (scripts/arc_conformance/tests/test_mla_moe_reference.py); both must give every expected value. Keys are sigma * 2^16 + bias; experts are taken by key descending, ties to the lower index; group scores are the sum of a group's two largest keys, ties to the lower group index.",
  "selection": [
    {"name": "all keys equal", "keys": [7, 7, 7, 7, 7, 7, 7, 7], "top_k": 3, "n_group": 1, "topk_group": 1, "expected": [0, 1, 2]},
    {"name": "all keys equal, groups of two, keep two", "keys": [7, 7, 7, 7, 7, 7, 7, 7], "top_k": 3, "n_group": 4, "topk_group": 2, "expected": [0, 1, 2]},
    {"name": "all keys equal, groups of two, keep one", "keys": [7, 7, 7, 7, 7, 7, 7, 7], "top_k": 2, "n_group": 4, "topk_group": 1, "expected": [0, 1]},
    {"name": "tie at the top and at the cut", "keys": [1, 4, 3, 3, 0, 3, 2, 4], "top_k": 3, "n_group": 1, "topk_group": 1, "expected": [1, 7, 2]},
    {"name": "tie at the top and at the cut, one more", "keys": [1, 4, 3, 3, 0, 3, 2, 4], "top_k": 4, "n_group": 1, "topk_group": 1, "expected": [1, 7, 2, 3]},
    {"name": "every group score tied: the lower groups win, a larger key in a dropped group is not taken", "keys": [3, 3, 6, 0, 1, 5, 0, 6], "top_k": 3, "n_group": 4, "topk_group": 2, "expected": [2, 0, 1]},
    {"name": "a repeated maximum counts twice in the group score", "keys": [5, 5, 0, 0, 6, 0, 0, 0], "top_k": 2, "n_group": 2, "topk_group": 1, "expected": [0, 1]},
    {"name": "tied group scores of four", "keys": [4, 0, 0, 4, 0, 4, 4, 0], "top_k": 2, "n_group": 2, "topk_group": 1, "expected": [0, 3]},
    {"name": "negative keys", "keys": [-5, -5, -7, -1], "top_k": 2, "n_group": 1, "topk_group": 1, "expected": [3, 0]},
    {"name": "group sums beyond i64 are exact", "keys": [4611686018427387904, 4611686018427387904, 4611686018427387904, 4611686018427387903], "top_k": 2, "n_group": 2, "topk_group": 1, "expected": [0, 1]},
    {"name": "every expert selected keeps the order", "keys": [2, 9, 2, 9], "top_k": 4, "n_group": 1, "topk_group": 1, "expected": [1, 3, 0, 2]}
  ],
  "logits": [
    {"name": "equal logits, the bias decides, then the index", "logits": [0, 0, 0, 0], "bias": [0, 1, -1, 1], "sigma": [32768, 32768, 32768, 32768], "top_k": 2, "n_group": 1, "topk_group": 1, "expected": [1, 3]},
    {"name": "different logits that saturate the sigmoid tie", "logits": [1099511627776, 0, 2199023255552, 1099511627776], "bias": [0, 0, 0, 0], "sigma": [65536, 32768, 65536, 65536], "top_k": 2, "n_group": 1, "topk_group": 1, "expected": [0, 2]},
    {"name": "logits of 16 and 64 saturate alike", "logits": [1048576, 4194304, 1048577], "bias": [0, 0, 0], "sigma": [65536, 65536, 65536], "top_k": 2, "n_group": 1, "topk_group": 1, "expected": [0, 1]},
    {"name": "negative saturation ties at zero", "logits": [-1099511627776, -2199023255552, -1099511627776], "bias": [0, 0, 0], "sigma": [0, 0, 0], "top_k": 2, "n_group": 1, "topk_group": 1, "expected": [0, 1]},
    {"name": "negative saturation, the bias decides", "logits": [-1099511627776, -2199023255552, -1099511627776], "bias": [0, 1, 0], "sigma": [0, 0, 0], "top_k": 2, "n_group": 1, "topk_group": 1, "expected": [1, 0]}
  ],
