    {"name": "eight saturated scores", "sigma": [65536, 65536, 65536, 65536, 65536, 65536, 65536, 65536], "rho": 10505490006, "normalize": true, "expected": [1313186250, 1313186250, 1313186250, 1313186250, 1313186250, 1313186250, 1313186250, 1313186250]},
