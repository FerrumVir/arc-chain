{
  "name": "@arc-chain/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for ARC Chain",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5",
    "jest": "^29.7",
    "ts-jest": "^29.1",
    "typescript": "^5.4"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(@noble)/)"
    ],
    "moduleNameMapper": {
      "^@noble/hashes/(.*)$": "<rootDir>/node_modules/@noble/hashes/$1"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT"
}
