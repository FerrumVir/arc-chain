*.pdf binary
# Tauri serializes this manifest with LF during Windows builds. Check it out in
# that canonical form so its strict post-build source-drift gate distinguishes
# real changes from Git's CRLF worktree conversion.
desktop/src-tauri/Cargo.toml text eol=lf
# This recovery trust root is content-addressed by the node and release
# tooling. Keep its exact canonical bytes stable on Windows checkouts.
scripts/recovery/durable-wal-boundary-sgp.json text eol=lf
# Preserve the byte-exact crates.io payload on every checkout. The canonical
# MIT text intentionally contains its published blank line at EOF.
vendor/third_party/glib-0.18.5/** text eol=lf
vendor/third_party/glib-0.18.5/LICENSE whitespace=-blank-at-eof
vendor/shared-buffer/** text eol=lf
vendor/wasmer-compiler/** text eol=lf
# Official K2.6 configuration and vectors are pinned as exact source bytes.
# CRLF conversion would break the official config SHA-256 on Windows.
docs/protocol/reference/kimi-k26/*.json -text
# Slice budget provenance pins the retained-source manifest by exact bytes too.
docs/protocol/packages/kimi-k26.source.json -text
# The legacy bridge verifies these real v0.8.11 release-manifest bytes with the
# release key in its unit tests. Any CRLF conversion would break the signature.
crates/arc-legacy-bridge/fixtures/** -text
